# PixelForge Studio — copy to .env and edit. .env is gitignored.

# ComfyUI HTTP address (no trailing slash).
PIXEFORGE_COMFYUI_URL=http://127.0.0.1:8188

# Asset files live here (relative paths are from the pixelforge-studio folder).
# SQLite metadata defaults to <storage>/pixelforge.db.
PIXEFORGE_STORAGE_DIR=storage

# API bind address.
PIXEFORGE_HOST=127.0.0.1
PIXEFORGE_PORT=8787

# Checkpoint filename as it appears in ComfyUI models/checkpoints.
PIXEFORGE_DEFAULT_MODEL=v1-5-pruned-emaonly.safetensors
PIXEFORGE_DEFAULT_LORA=
PIXEFORGE_DEFAULT_WIDTH=512
PIXEFORGE_DEFAULT_HEIGHT=512
PIXEFORGE_DEFAULT_STEPS=20
PIXEFORGE_DEFAULT_CFG=7
PIXEFORGE_DEFAULT_WORKFLOW=txt2sprite
